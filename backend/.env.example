# Salin ke .env lalu sesuaikan. Nilai di sini = default instance 1.
# Catatan: run.ps1 / run.sh mengatur PORT, DATABASE_URL, dan CORS_ORIGINS
# lewat environment OS per-instance, dan env OS MENANG atas file .env ini.
APP_ENV=development
PORT=7081

# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://medclaim:medclaim@localhost:7433/medclaim?sslmode=disable

# Asal frontend yang diizinkan (pisahkan dengan koma).
# Frontend MedClaim memakai blok 704N (7041 = instance 1); port lain dipakai proyek lain.
CORS_ORIGINS=http://localhost:7041,http://localhost:5173

SESSION_TTL_HOURS=168
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Sandi semua akun demo hasil seed (admin/casemix/coder/direktur/dpjp @demo.medclaim.id)
SEED_PASSWORD=MedClaim#demo2026
